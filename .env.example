PORT=3000
HOST=127.0.0.1
# Public URL supplied in the company profile; change to match the final deployment.
SITE_URL=https://www.epcoispl.com/in/
# Keep this on a private, persistent disk when hosting. Never in a public directory.
ENQUIRY_DATA_DIR=.data/enquiries
ENQUIRY_RETENTION_DAYS=90
# Optional email notifications. Configure a verified sender in your own Resend account.
# RESEND_API_KEY=
# ENQUIRY_FROM=EPCO Website <website@your-verified-domain.example>
ENQUIRY_TO=epcoispl@gmail.com
# Set true only when your trusted reverse proxy replaces X-Forwarded-For.
TRUST_PROXY=false
