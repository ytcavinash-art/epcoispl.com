{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EPCO: Start localhost",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "epco-preview",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "EPCO website: http://.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "EPCO: Build Cloudflare",
      "type": "npm",
      "script": "build:cloudflare",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "EPCO: Test website",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "EPCO: Check before commit",
      "dependsOrder": "sequence",
      "dependsOn": ["EPCO: Build Cloudflare", "EPCO: Test website"],
      "problemMatcher": []
    }
  ]
}
